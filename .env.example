# App Configuration
APP_NAME=InvoiceIQ
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite:///./data/app.db

# Security & Auth
SECRET_KEY=change-me-to-a-super-secret-random-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Storage & Paths
UPLOAD_DIR=./uploads
LOG_DIR=./logs
BACKUP_DIR=./backups

# OCR & Scanning
OCR_ENABLED=true
TESSERACT_CMD=
POPPLER_PATH=

# Email / SMTP (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# GST Filing Reminder Days
GST_GSTR1_DUE_DAY=11
GST_GSTR3B_DUE_DAY=20

# Tally Ledgers
TALLY_LEDGER_PURCHASE=Purchase
TALLY_LEDGER_SALES=Sales
TALLY_LEDGER_INPUT_CGST=Input CGST
TALLY_LEDGER_INPUT_SGST=Input SGST
TALLY_LEDGER_INPUT_IGST=Input IGST
TALLY_LEDGER_OUTPUT_CGST=Output CGST
TALLY_LEDGER_OUTPUT_SGST=Output SGST
TALLY_LEDGER_OUTPUT_IGST=Output IGST
TALLY_LEDGER_ROUND_OFF=Round Off
